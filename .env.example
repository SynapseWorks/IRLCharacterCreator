# Optional image-rendering provider.
# Keep these server-side; never expose them with NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2
ENABLE_IMAGE_RENDERING=false

# Supabase browser client. These two values are intended for client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional future server-only Supabase key. Do not expose this in browser code or commit a real value.
SUPABASE_SECRET_KEY=
